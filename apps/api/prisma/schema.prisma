// FSG Work Solutions — control system schema
// Monetary values use Float for simplicity (this is an operations portal, not a ledger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum SubsidiaryType {
  ONLINE_SHOP
  FARM_LAYERS
  FARM_BROILERS
  FARM_CROPS
  FARM_LIVESTOCK
  ASSETS
  LAND_ESTATE
  INVESTMENTS
}

enum SubsidiaryStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

/// How a product's stock is tracked across its variants.
///
/// PER_VARIANT — each variant is its own inventory line with its own count.
/// Right for sealed goods bought and sold as distinct units: Hypo 500ml and
/// Hypo 1000ml are separate bottles on the shelf and cannot substitute.
///
/// POOLED — the product holds one pool of stock measured in its base `unit`,
/// and every variant draws `packSize` base units from it. Right for goods
/// bought in bulk and repackaged: 53 kg of Big Bull Rice can be sold loose by
/// the kilo or as a 3 kg bag, and either way the same pool goes down.
enum StockMode {
  PER_VARIANT
  POOLED
}

enum SaleChannel {
  ONLINE
  IN_STORE
  WHOLESALE
}

enum BatchType {
  LAYERS
  BROILERS
}

enum BatchStatus {
  ACTIVE
  HARVESTED
  CLOSED
}

enum CropStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTED
}

enum LivestockSex {
  MALE
  FEMALE
}

enum LivestockStatus {
  ALIVE
  SOLD
  DECEASED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  DISPOSED
}

enum MaintenanceStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LandStatus {
  OWNED
  FINANCING
  LEASED
}

enum InvestmentType {
  FIXED_DEPOSIT
  BONDS
  EQUITY
  REAL_ESTATE
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  WITHDRAWN
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertType {
  LOW_STOCK
  MAINTENANCE_DUE
  LAND_PAYMENT_DUE
  INVESTMENT_MATURITY
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum CropInputType {
  SEED
  FERTILIZER
  HERBICIDE
  PESTICIDE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  NEEDS_INFO
  CANCELLED
}

enum FinancialRequestType {
  CASH_EXPENSE
  BANK_TRANSFER
  AIRTIME
  DATA_BUNDLE
  ELECTRICITY_BILL
}

enum PaymentProvider {
  NONE
  NOMBA
  MONNIFY
}

enum ProviderStatus {
  NOT_INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum ExpensePaymentStatus {
  PAID
  APPROVED_NOT_PAID
  PROCESSING
  FAILED
}

enum StaffDepartment {
  FARM
  SHOP
  HR
  ASSETS
  CROPS
  LIVESTOCK
  FINANCE
  ADMIN
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum RequestEntityType {
  STOCK_REQUEST
  FINANCIAL_REQUEST
  STAFF
  GENERAL
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_DENIED
  NEEDS_INFO
  REQUEST_UPDATED
  PAYMENT_STATUS
  GENERAL
}

enum WebhookVerificationStatus {
  VERIFIED
  FAILED
  SKIPPED
}

// ─── Access control (dynamic RBAC) ──────────────────────────────────────────

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  subsidiaryId String?
  subsidiary   Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  movements                  InventoryMovement[]
  sales                      Sale[]
  salesVerified              Sale[]              @relation("SaleVerifier")
  customers                  Customer[]
  expenses                   Expense[]
  auditLogs                  AuditLog[]
  staffProfile               Staff?
  stockRequestsRequested     StockRequest[]      @relation("StockRequestRequester")
  stockRequestsApproved      StockRequest[]      @relation("StockRequestApprover")
  financialRequestsRequested FinancialRequest[]  @relation("FinancialRequestRequester")
  financialRequestsApproved  FinancialRequest[]  @relation("FinancialRequestApprover")
  financialRequestsExecuted  FinancialRequest[]  @relation("FinancialRequestExecutor")
  requestComments            RequestComment[]
  notifications              Notification[]
  farmDispatches             FarmDispatch[]

  @@map("users")
}

// ─── Business tables ────────────────────────────────────────────────────────

model Subsidiary {
  id          String           @id @default(cuid())
  name        String
  type        SubsidiaryType
  status      SubsidiaryStatus @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users             User[]
  products          Product[]
  sales             Sale[]
  customers         Customer[]
  farmBatches       FarmBatch[]
  crops             Crop[]
  livestock         Livestock[]
  assets            Asset[]
  expenses          Expense[]
  staff             Staff[]
  stockRequests     StockRequest[]
  financialRequests FinancialRequest[]

  @@map("subsidiaries")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id             String      @id @default(cuid())
  subsidiaryId   String?
  subsidiary     Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  name           String
  sku            String?     @unique
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description    String?
  /// Base unit of measure, e.g. "pcs", "kg", "crate", "bag". For a POOLED
  /// product this is the unit `quantityOnHand` is counted in and the unit each
  /// variant's `packSize` multiplies.
  unit           String      @default("pcs")
  stockMode      StockMode   @default(PER_VARIANT)
  /// Default selling/cost price, inherited by new variants. Variants may
  /// override both; the variant's price is what a sale actually charges.
  unitPrice      Float       @default(0)
  costPrice      Float       @default(0)
  /// Authoritative only when stockMode = POOLED. For PER_VARIANT products this
  /// is a rolled-up sum of variant stock, rewritten whenever a variant moves,
  /// so dashboards and list views can read one number without joining.
  quantityOnHand Int         @default(0)
  reorderLevel   Int         @default(0)
  imageUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  variants       ProductVariant[]
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  stockRequests  StockRequest[]
  farmDispatches FarmDispatch[]

  @@map("products")
}

/// A sellable form of a product — a pack size, a bottle size, a loose measure.
/// Every product has at least one, so sales always reference a variant.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Label shown to staff, e.g. "Loose (kg)", "3 kg bag", "500ml".
  name      String
  sku       String? @unique
  /// Base units consumed per unit sold. Only meaningful when the parent is
  /// POOLED — a 3 kg bag of a kg-based product has packSize 3. Always 1 for
  /// PER_VARIANT products, where the variant counts its own whole units.
  packSize  Float   @default(1)
  unitPrice Float   @default(0)
  costPrice Float   @default(0)
  /// Authoritative only when the parent is PER_VARIANT. For POOLED products
  /// availability is derived from the product pool and ignores this column.
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  /// The variant pre-selected in pickers, and the one legacy rows were
  /// migrated onto. Exactly one per product.
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements      InventoryMovement[]
  saleItems      SaleItem[]
  stockRequests  StockRequest[]
  farmDispatches FarmDispatch[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_variants")
}

model InventoryMovement {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Which variant moved. Null only on rows predating variants that could not
  /// be matched to one; everything written since resolves a variant first.
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type         MovementType
  /// Counted in variant units (e.g. 2 = two 3 kg bags), not base units.
  quantity     Int
  unitCost     Float?
  reference    String?
  note         String?
  receiptUrl   String?
  occurredAt   DateTime      @default(now())
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  stockRequest StockRequest?
  saleItem     SaleItem?
  farmDispatch FarmDispatch?

  @@index([productId])
  @@index([variantId])
  @@map("inventory_movements")
}

/// A sale is an order header: one customer, many product lines, plus a
/// logistics (delivery) fee charged on top of the line totals.
model Sale {
  id           String      @id @default(cuid())
  subsidiaryId String?
  subsidiary   Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Buyer name for walk-in sales with no customer record; also snapshots the
  /// customer's name at the time of sale.
  customerName String?
  /// Sum of the line totals, before logistics.
  subtotal     Float       @default(0)
  logisticsFee Float       @default(0)
  /// subtotal + logisticsFee
  totalAmount  Float
  channel      SaleChannel @default(ONLINE)
  note         String?
  soldAt       DateTime    @default(now())
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  verifiedById String?
  verifiedBy   User?       @relation("SaleVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  proofUrl     String?

  items SaleItem[]

  @@index([soldAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                  String             @id @default(cuid())
  saleId              String
  sale                Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId           String?
  variant             ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Name, variant label and unit captured at sale time so the line survives
  /// product edits — and still reads correctly if the variant is later removed.
  productName         String
  variantName         String?
  unit                String             @default("pcs")
  quantity            Int
  unitPrice           Float
  /// Cost per unit captured at sale time (variant cost, falling back to the
  /// product's), so profit figures survive later cost-price edits.
  unitCost            Float              @default(0)
  lineTotal           Float
  inventoryMovementId String?            @unique
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
  @@map("sale_items")
}

model Customer {
  id           String      @id @default(cuid())
  name         String
  company      String?
  phone        String?
  email        String?
  addressLine  String?
  city         String?
  state        String?
  country      String?
  notes        String?
  subsidiaryId String?
  subsidiary   Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sales Sale[]

  @@index([name])
  @@map("customers")
}

model FarmBatch {
  id              String      @id @default(cuid())
  subsidiaryId    String?
  subsidiary      Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  name            String
  type            BatchType
  breed           String?
  initialCount    Int
  startDate       DateTime
  expectedHarvest DateTime?
  status          BatchStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  eggProduction    EggProduction[]
  mortalityRecords MortalityRecord[]
  feedRecords      FeedRecord[]
  dispatches       FarmDispatch[]

  @@map("farm_batches")
}

model EggProduction {
  id             String    @id @default(cuid())
  batchId        String
  batch          FarmBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date           DateTime
  traysCollected Int       @default(0)
  eggsCollected  Int       @default(0)
  damaged        Int       @default(0)
  gradeA         Int       @default(0)
  gradeB         Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([batchId])
  @@index([date])
  @@map("egg_production")
}

model MortalityRecord {
  id        String    @id @default(cuid())
  batchId   String
  batch     FarmBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date      DateTime
  count     Int
  cause     String?
  createdAt DateTime  @default(now())

  @@index([batchId])
  @@map("mortality_records")
}

model FeedRecord {
  id         String    @id @default(cuid())
  batchId    String
  batch      FarmBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date       DateTime
  feedType   String?
  /// Legacy records were counted in kg; new entries count bags and leave this 0.
  quantityKg Float     @default(0)
  /// Feed is bought in bags: total cost = quantityBags × costPerBag.
  quantityBags Float   @default(0)
  costPerBag   Float?
  cost       Float     @default(0)
  createdAt  DateTime  @default(now())

  @@index([batchId])
  @@map("feed_records")
}

enum FarmDispatchType {
  EGGS
  BIRDS
}

/// Goods leaving a batch: eggs sent to the shop, or broilers processed and
/// sent out for sale. When a shop product is linked, the dispatch posts an
/// inventory movement IN so shop stock rises in the same transaction.
model FarmDispatch {
  id                  String             @id @default(cuid())
  batchId             String
  batch               FarmBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type                FarmDispatchType
  date                DateTime
  /// Eggs (pieces) or birds, counted on the farm side.
  quantity            Int
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId           String?
  variant             ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Units of the shop variant added to stock (e.g. crates of 30).
  unitsAdded          Int?
  inventoryMovementId String?            @unique
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)
  destination         String?
  note                String?
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([batchId])
  @@index([date])
  @@map("farm_dispatches")
}

model Crop {
  id              String      @id @default(cuid())
  subsidiaryId    String?
  subsidiary      Subsidiary? @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  name            String
  variety         String?
  plot            String?
  areaHectares    Float       @default(0)
  plantingDate    DateTime?
  expectedHarvest DateTime?
  expectedYield   Float?
  actualYield     Float?
  status          CropStatus  @default(PLANNED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  inputs    CropInput[]
  rotations CropRotation[]

  @@map("crops")
}

model Livestock {
  id              String          @id @default(cuid())
  subsidiaryId    String?
  subsidiary      Subsidiary?     @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  species         String
  tagNumber       String?
  breed           String?
  sex             LivestockSex?
  dob             DateTime?
  acquisitionCost Float?
  weightKg        Float?
  status          LivestockStatus @default(ALIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("livestock")
}

model Asset {
  id           String         @id @default(cuid())
  subsidiaryId String?
  subsidiary   Subsidiary?    @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  name         String
  category     String?
  serialNumber String?
  purchaseDate DateTime?
  purchaseCost Float          @default(0)
  currentValue Float          @default(0)
  condition    AssetCondition @default(GOOD)
  location     String?
  imageUrl     String?
  status       AssetStatus    @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  maintenanceLogs MaintenanceLog[]

  @@map("assets")
}

model MaintenanceLog {
  id            String            @id @default(cuid())
  assetId       String
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          String?
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float             @default(0)
  vendor        String?
  status        MaintenanceStatus @default(SCHEDULED)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([assetId])
  @@index([scheduledDate])
  @@map("maintenance_logs")
}

model LandPlot {
  id              String     @id @default(cuid())
  name            String
  location        String?
  sizeAcres       Float      @default(0)
  purchasePrice   Float      @default(0)
  totalDue        Float      @default(0)
  titleDocUrl     String?
  acquisitionDate DateTime?
  status          LandStatus @default(OWNED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments LandPayment[]

  @@map("land_plots")
}

model LandPayment {
  id        String   @id @default(cuid())
  plotId    String
  plot      LandPlot @relation(fields: [plotId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  createdAt DateTime @default(now())

  @@index([plotId])
  @@map("land_payments")
}

model Investment {
  id             String           @id @default(cuid())
  name           String
  type           InvestmentType   @default(OTHER)
  institution    String?
  principal      Float            @default(0)
  interestRate   Float            @default(0)
  startDate      DateTime?
  maturityDate   DateTime?
  expectedReturn Float?
  documentUrl    String?
  status         InvestmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([maturityDate])
  @@map("investments")
}

model Alert {
  id            String        @id @default(cuid())
  type          AlertType     @default(GENERAL)
  severity      AlertSeverity @default(INFO)
  title         String
  message       String?
  subsidiaryId  String?
  relatedEntity String?
  /// Stable key for auto-generated alerts (e.g. "low_stock:<productId>"); null for manual alerts.
  sourceKey     String?       @unique
  isRead        Boolean       @default(false)
  isResolved    Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([isResolved])
  @@map("alerts")
}

model Expense {
  id               String               @id @default(cuid())
  subsidiaryId     String?
  subsidiary       Subsidiary?          @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  category         String
  description      String?
  vendor           String?
  amount           Float
  incurredAt       DateTime             @default(now())
  receiptUrl       String?
  paymentStatus    ExpensePaymentStatus @default(PAID)
  createdById      String?
  createdBy        User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  financialRequest FinancialRequest?

  @@index([subsidiaryId])
  @@index([incurredAt])
  @@index([category])
  @@map("expenses")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     AuditAction
  entity     String
  entityId   String?
  summary    String
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

model CropInput {
  id        String        @id @default(cuid())
  cropId    String
  crop      Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  type      CropInputType @default(SEED)
  name      String
  quantity  Float?
  unit      String?
  cost      Float         @default(0)
  date      DateTime
  notes     String?
  createdAt DateTime      @default(now())

  @@index([cropId])
  @@map("crop_inputs")
}

model CropRotation {
  id        String    @id @default(cuid())
  cropId    String
  crop      Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  season    String
  cropName  String
  date      DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([cropId])
  @@map("crop_rotations")
}

model Staff {
  id            String          @id @default(cuid())
  name          String
  phone         String?
  email         String?
  jobTitle      String?
  department    StaffDepartment @default(OTHER)
  subsidiaryId  String?
  subsidiary    Subsidiary?     @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  status        StaffStatus     @default(ACTIVE)
  startDate     DateTime?
  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?
  linkedUserId  String?         @unique
  linkedUser    User?           @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([department])
  @@index([subsidiaryId])
  @@map("staff")
}

model StockRequest {
  id                  String             @id @default(cuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  subsidiaryId        String?
  subsidiary          Subsidiary?        @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  type                MovementType
  quantity            Int
  unitCost            Float?
  reference           String?
  note                String?
  receiptUrl          String?
  status              ApprovalStatus     @default(PENDING)
  decisionNote        String?
  requestedById       String?
  requestedBy         User?              @relation("StockRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById        String?
  approvedBy          User?              @relation("StockRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decidedAt           DateTime?
  inventoryMovementId String?            @unique
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([requestedById])
  @@index([productId])
  @@index([variantId])
  @@map("stock_requests")
}

model FinancialRequest {
  id                String                 @id @default(cuid())
  type              FinancialRequestType
  subsidiaryId      String?
  subsidiary        Subsidiary?            @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  department        StaffDepartment?
  amount            Float
  category          String
  description       String?
  vendor            String?
  payeeName         String?
  bankName          String?
  bankCode          String?
  bankAccountNumber String?
  requestedFor      DateTime?
  attachmentUrl     String?
  status            ApprovalStatus         @default(PENDING)
  decisionNote      String?
  requestedById     String?
  requestedBy       User?                  @relation("FinancialRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        User?                  @relation("FinancialRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  phoneNumber       String?
  network           String?
  dataPlan          String?
  disco             String?
  customerId        String?
  meterType         String?
  payerName         String?
  merchantTxRef     String?                @unique
  provider          PaymentProvider        @default(NONE)
  providerStatus    ProviderStatus         @default(NOT_INITIATED)
  providerReference String?
  providerResponse  Json?
  executedAt        DateTime?
  executedById      String?
  executedBy        User?                  @relation("FinancialRequestExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  expenseId         String?                @unique
  expense           Expense?               @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  providerEvents    PaymentProviderEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
  @@index([type])
  @@index([requestedById])
  @@map("financial_requests")
}

model RequestComment {
  id            String            @id @default(cuid())
  entityType    RequestEntityType
  entityId      String
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  message       String
  isInstruction Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([entityType, entityId])
  @@map("request_comments")
}

model Notification {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType  @default(GENERAL)
  title      String
  message    String?
  entityType RequestEntityType @default(GENERAL)
  entityId   String?
  href       String?
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())

  @@index([userId, isRead])
  @@index([entityType, entityId])
  @@map("notifications")
}

model PaymentProviderEvent {
  id                 String                    @id @default(cuid())
  provider           PaymentProvider           @default(MONNIFY)
  eventId            String
  eventType          String
  signature          String?
  signatureAlgorithm String?
  signatureVersion   String?
  providerTimestamp  DateTime?
  verificationStatus WebhookVerificationStatus @default(SKIPPED)
  payload            Json
  merchantTxRef      String?
  providerReference  String?
  financialRequestId String?
  financialRequest   FinancialRequest?         @relation(fields: [financialRequestId], references: [id], onDelete: SetNull)
  processedAt        DateTime?
  createdAt          DateTime                  @default(now())

  @@unique([provider, eventId])
  @@index([eventType])
  @@index([merchantTxRef])
  @@index([providerReference])
  @@map("payment_provider_events")
}

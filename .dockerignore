# Git / IDE
.git
.github
.claude
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Dependencies & build output (rebuilt inside images)
**/node_modules
**/.pnpm-store
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo

# Env & secrets — inject at runtime (or Coolify), never bake into images
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs / local runtime
**/*.log
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# Docs & misc that don't affect builds
*.md
!README.md
.prettierrc
.gitignore
.api-check.*
.dev-server.*
.webhook-*

# ─── Database ─────────────────────────────────────────────────────────────
# Host-side tooling (pnpm dev / Prisma Studio) uses localhost.
# Inside Docker Compose the API uses hostname `postgres` (set below under Compose).
POSTGRES_USER=fsg
POSTGRES_PASSWORD=fsg_password
POSTGRES_DB=fsg_control
# Host publish only when using docker-compose.local.yml (local dev)
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fsg:fsg_password@localhost:5432/fsg_control?schema=public"

# ─── API ─────────────────────────────────────────────────────────────────
PORT=4000
# Host publish only with docker-compose.local.yml
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"

# JWT secrets — change these in production!
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# true when the app is served over HTTPS (Coolify / production). Required for
# the httpOnly refresh cookie to be set by modern browsers on HTTPS origins.
COOKIE_SECURE="false"

# Set true once on first deploy to load roles, users and sample data, then false.
SEED_ON_START="false"

# ─── Web ─────────────────────────────────────────────────────────────────
WEB_PORT=3000
# Browser-facing API URL (baked into the Next.js client at image build time).
# Local Docker: http://localhost:4000
# Coolify:      https://api.your-domain.com   (rebuild web after changing)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Docker Compose notes ────────────────────────────────────────────────
# The API container builds DATABASE_URL from POSTGRES_* and always talks to
# hostname `postgres` — you do not need a separate compose DATABASE_URL.
# WEB_ORIGIN / NEXT_PUBLIC_API_URL should be your public URLs on Coolify.

# ─── Monnify ───────────────────────────────────────────────────────────────
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WALLET_ACCOUNT_NUMBER=""
MONNIFY_WEBHOOK_SECRET=""
MONNIFY_ENV="sandbox"
# Bills vending (airtime/data/electricity) needs Monnify to activate Bills Payment
# on the merchant account first. Until then leave this off — staff request a bank
# transfer to their own account and purchase bills themselves.
MONNIFY_BILLS_ENABLED="false"
